# ─── App ───────────────────────────────────────────
APP_NAME=barazarte-api
APP_ENV=development          # development | staging | production | test
DEBUG=true                   # false en staging y production
DOCS_ENABLED=true            # false en production
FRONTEND_BASE_URL=http://localhost:3000
# Origenes CORS separados por comas
CORS_ORIGINS=http://localhost:3000
# true solo si hay un proxy de confianza (Nginx) delante que fija X-Forwarded-For
TRUST_PROXY_HEADERS=false

# ─── Base de datos ─────────────────────────────────
DATABASE_URL=postgresql+psycopg://barazarte:barazarte@localhost:5432/barazarte

# ─── Redis / Celery ────────────────────────────────
REDIS_URL=redis://localhost:6379/0
# redis | memory (memory solo para tests / desarrollo con un unico proceso)
RATE_LIMIT_BACKEND=redis

# ─── Auth / JWT ────────────────────────────────────
JWT_SECRET_KEY=              # Generar con: openssl rand -hex 32 (minimo 32 caracteres)
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12
# Clave Fernet para cifrar la contrasena SMTP guardada desde el panel admin.
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Si se deja vacia se deriva de JWT_SECRET_KEY (HKDF); cambiar cualquiera de las dos
# invalida la contrasena guardada y habra que volver a introducirla en el panel.
SETTINGS_ENCRYPTION_KEY=
# Cookie del refresh token: Secure=true en staging/production (HTTPS)
COOKIE_SECURE=false

# ─── Storage (MinIO) ───────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=barazarte
MINIO_SECURE=false
# URL publica base desde la que el navegador lee las imagenes (bucket con lectura anonima)
MINIO_PUBLIC_BASE_URL=http://localhost:9000
MAX_UPLOAD_BYTES=10485760
MAX_IMAGES_PER_ARTWORK=10
# Limite de obras (incluidos borradores) de los artistas que se registran
DEFAULT_MAX_ARTWORKS=5

# ─── Email (SMTP) ──────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
MAIL_FROM=BarazArte <no-reply@barazarte.local>

# ─── Rate limits (peticiones por ventana) ──────────
INQUIRY_RATE_LIMIT=5
INQUIRY_RATE_WINDOW_SECONDS=3600
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=60
REGISTER_RATE_LIMIT=5
REGISTER_RATE_WINDOW_SECONDS=3600
PASSWORD_RESET_RATE_LIMIT=5
PASSWORD_RESET_RATE_WINDOW_SECONDS=3600
# Visitas propias (POST /track): limite generoso por IP
TRACK_RATE_LIMIT=120
TRACK_RATE_WINDOW_SECONDS=60

# ─── Enlaces de email (caducidad) ──────────────────
EMAIL_VERIFY_EXPIRE_HOURS=48
PASSWORD_RESET_EXPIRE_MINUTES=60
